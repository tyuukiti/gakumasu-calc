                                   Visibility="{Binding IsDaAtCap, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Vi -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="36"/>
