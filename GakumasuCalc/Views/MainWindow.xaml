<Window x:Class="GakumasuCalc.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GakumasuCalc.ViewModels"
        xmlns:conv="clr-namespace:GakumasuCalc.Converters"
        xmlns:models="clr-namespace:GakumasuCalc.Models"
        xmlns:views="clr-namespace:GakumasuCalc.Views"
        Title="学マス 育成ステータス理論値計算ツール"
        Width="780" MinWidth="700" Height="950"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/favicon.ico"
        FontFamily="Yu Gothic UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:ActionTypeToStringConverter x:Key="ActionToStr"/>
    </Window.Resources>

    <TabControl>
        <TabItem Header="通常モード">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>

            <!-- Title -->
            <TextBlock Text="学マス 育成ステータス理論値計算ツール"
                       FontSize="20" FontWeight="Bold" Foreground="#333"
                       Margin="0,0,0,16"/>

            <!-- 更新通知バナー (HasUpdate && !Dismissed のときだけ表示) -->
            <Border Background="#E3F2FD" BorderBrush="#5C6BC0" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding UpdateMessage}"
                               FontSize="13" Foreground="#1A237E"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="リリースページを開く"
                            Command="{Binding OpenReleasePageCommand}"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="12" Padding="10,4" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Content="✕"
                            Command="{Binding DismissUpdateBannerCommand}"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="12" Padding="8,4" Margin="4,0,0,0"
                            ToolTip="このセッションで非表示にする"/>
                </Grid>
            </Border>

            <!-- 育成プラン選択 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="育成プラン" Style="{StaticResource SectionHeader}"/>
                    <ComboBox ItemsSource="{Binding AvailablePlans}"
                              SelectedItem="{Binding SelectedPlan}"
                              DisplayMemberPath="Name"
                              FontSize="14" Padding="8,6" MinWidth="300"/>
                </StackPanel>
            </Border>

            <!-- 育成タイプ + 所持フィルタ -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="育成タイプ" Style="{StaticResource SectionHeader}"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding PlanTypeOptions}"
                                  SelectedValue="{Binding SelectedPlanType}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="DisplayName"
                                  FontSize="14" Padding="8,6" MinWidth="200"/>
                        <CheckBox Content="所持カードのみで計算" IsChecked="{Binding OwnedOnly}"
                                  FontSize="13" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <CheckBox Content="コンテストモード" IsChecked="{Binding ContestMode}"
                                  ToolTip="スキルカード・コンテストアイテムのサポカを除外"
                                  FontSize="13" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 属性設定 (Web版と同じ薄背景カード) -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="属性設定" Style="{StaticResource SectionHeader}"/>

                    <!-- Vocal -->
                    <Border Background="{StaticResource VoBgBrush}" CornerRadius="6"
                            Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vocal" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource VoBrushDark}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding VoRole}"
                                      FontSize="12" Padding="6,4" Width="85" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="SP率枚数" FontSize="12" Foreground="#555"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding VoSpCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         Style="{StaticResource NumericTextBox}"
                                         Width="56" FontSize="13" Padding="6,4"
                                         HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Dance -->
                    <Border Background="{StaticResource DaBgBrush}" CornerRadius="6"
                            Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dance" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource DaBrushDark}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding DaRole}"
                                      FontSize="12" Padding="6,4" Width="85" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="SP率枚数" FontSize="12" Foreground="#555"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DaSpCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         Style="{StaticResource NumericTextBox}"
                                         Width="56" FontSize="13" Padding="6,4"
                                         HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Visual -->
                    <Border Background="{StaticResource ViBgBrush}" CornerRadius="6"
                            Padding="12,8" Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Visual" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource ViBrushDark}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RoleOptions}"
                                      SelectedItem="{Binding ViRole}"
                                      FontSize="12" Padding="6,4" Width="85" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="SP率枚数" FontSize="12" Foreground="#555"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding ViSpCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         Style="{StaticResource NumericTextBox}"
                                         Width="56" FontSize="13" Padding="6,4"
                                         HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 必須カード選択 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run Text="必須カード"/>
                        <Run Text="（" Foreground="#999"/><Run Text="{Binding RequiredCards.Count, Mode=OneWay}" Foreground="#999"/><Run Text="/4）" Foreground="#999"/>
                    </TextBlock>
                    <!-- カード追加行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                  ItemsSource="{Binding AvailableCardsForRequired}"
                                  SelectedItem="{Binding SelectedRequiredCard}"
                                  DisplayMemberPath="Name"
                                  MinWidth="300" FontSize="14" Padding="8,6"/>
                        <Button Content="追加" Command="{Binding AddRequiredCardCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="8,0,0,0" Padding="12,6" FontSize="13"/>
                    </StackPanel>
                    <!-- 選択済みカード一覧 -->
                    <ItemsControl ItemsSource="{Binding RequiredCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Type}" FontWeight="Bold" FontSize="12" Width="30"
                                               VerticalAlignment="Center" Foreground="#666"/>
                                    <TextBlock Text="{Binding Rarity}" FontSize="12" Width="30"
                                               VerticalAlignment="Center" Foreground="#999"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                               MinWidth="200"/>
                                    <Button Content="✕" FontSize="10" Padding="4,2"
                                            Command="{Binding DataContext.RemoveRequiredCardCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#999" MinWidth="0" MinHeight="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 除外カード選択 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}">
                        <Run Text="除外カード"/>
                        <Run Text="（" Foreground="#999"/><Run Text="{Binding ExcludedCards.Count, Mode=OneWay}" Foreground="#999"/><Run Text="）" Foreground="#999"/>
                    </TextBlock>
                    <!-- カード追加行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                  ItemsSource="{Binding AvailableCardsForExcluded}"
                                  SelectedItem="{Binding SelectedExcludedCard}"
                                  DisplayMemberPath="Name"
                                  MinWidth="300" FontSize="14" Padding="8,6"/>
                        <Button Content="追加" Command="{Binding AddExcludedCardCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="8,0,0,0" Padding="12,6" FontSize="13"/>
                    </StackPanel>
                    <!-- 除外済みカード一覧 -->
                    <ItemsControl ItemsSource="{Binding ExcludedCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding Type}" FontWeight="Bold" FontSize="12" Width="30"
                                               VerticalAlignment="Center" Foreground="#666"/>
                                    <TextBlock Text="{Binding Rarity}" FontSize="12" Width="30"
                                               VerticalAlignment="Center" Foreground="#999"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                                               MinWidth="200" Foreground="#C0392B"/>
                                    <Button Content="✕" FontSize="10" Padding="4,2"
                                            Command="{Binding DataContext.RemoveExcludedCardCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#999" MinWidth="0" MinHeight="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- キャラ選択 (折りたたみ式・任意) -->
            <Border Style="{StaticResource SectionCard}">
                <Expander IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="キャラ選択" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#333" VerticalAlignment="Center"/>
                            <TextBlock Text="（任意）" FontSize="11" Foreground="#999"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedCharacterDisplay}"
                                       FontSize="12" Foreground="#666" Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <!-- キャラタイル(7列グリッド) -->
                        <ItemsControl ItemsSource="{Binding CharacterTiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectCharacterCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Character}"
                                            Background="{Binding BackgroundBrush}"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="{Binding BorderThickness}"
                                            Margin="3" Padding="0" Height="60"
                                            ToolTip="{Binding Name}" Cursor="Hand">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Initial}" FontSize="20" FontWeight="Bold"
                                                       Foreground="{Binding ForegroundBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="9"
                                                       Foreground="{Binding ForegroundBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="60"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 3凸ボーナス切替（OFFで3凸分を減算） -->
                        <CheckBox Content="3凸レッスンボーナス込み"
                                  IsChecked="{Binding Uncap3BonusEnabled}"
                                  FontSize="11" Margin="0,8,0,0"
                                  Visibility="{Binding HasUncap3Bonus, Converter={StaticResource BoolToVis}}"/>
                        <!-- STEP4ボーナス切替（ONで基礎・パラボに加算。デフォルトON） -->
                        <CheckBox Content="STEP4ボーナス込み"
                                  IsChecked="{Binding Step4BonusEnabled}"
                                  FontSize="11" Margin="0,4,0,0"
                                  Visibility="{Binding HasStep4Bonus, Converter={StaticResource BoolToVis}}"/>
                        <!-- 補正サマリ -->
                        <TextBlock Text="{Binding CharacterBonusSummary}"
                                   FontSize="11" Foreground="#666" Margin="0,4,0,0"
                                   Visibility="{Binding HasSelectedCharacter, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- 持ち込みメモリー (折りたたみ式・任意) -->
            <Border Style="{StaticResource SectionCard}">
                <Expander IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="持ち込みメモリー" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#333" VerticalAlignment="Center"/>
                            <TextBlock Text="（最大4枚・任意）" FontSize="11" Foreground="#999"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,0">
                        <!-- 列ヘッダ -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Vocal" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource VoBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Dance" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DaBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Visual" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource ViBrush}" HorizontalAlignment="Center"/>
                        </Grid>
                        <!-- 4スロット -->
                        <ItemsControl ItemsSource="{Binding MemoryBonuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="12"
                                                   Foreground="#666" VerticalAlignment="Center"/>
                                        <!-- Vocal -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBox Text="{Binding VoValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.##}}"
                                                     Style="{StaticResource NumericTextBox}"
                                                     Width="60" FontSize="12" Padding="4,3"
                                                     HorizontalContentAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding VoType}" SelectedValuePath="Tag"
                                                      FontSize="12" Padding="4,2" Width="46" Margin="4,0,0,0">
                                                <ComboBoxItem Content="実" Tag="{x:Static models:MemoryBonusType.Flat}"/>
                                                <ComboBoxItem Content="%" Tag="{x:Static models:MemoryBonusType.ParaBonus}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Dance -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBox Text="{Binding DaValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.##}}"
                                                     Style="{StaticResource NumericTextBox}"
                                                     Width="60" FontSize="12" Padding="4,3"
                                                     HorizontalContentAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding DaType}" SelectedValuePath="Tag"
                                                      FontSize="12" Padding="4,2" Width="46" Margin="4,0,0,0">
                                                <ComboBoxItem Content="実" Tag="{x:Static models:MemoryBonusType.Flat}"/>
                                                <ComboBoxItem Content="%" Tag="{x:Static models:MemoryBonusType.ParaBonus}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <!-- Visual -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBox Text="{Binding ViValue, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.##}}"
                                                     Style="{StaticResource NumericTextBox}"
                                                     Width="60" FontSize="12" Padding="4,3"
                                                     HorizontalContentAlignment="Center"/>
                                            <ComboBox SelectedValue="{Binding ViType}" SelectedValuePath="Tag"
                                                      FontSize="12" Padding="4,2" Width="46" Margin="4,0,0,0">
                                                <ComboBoxItem Content="実" Tag="{x:Static models:MemoryBonusType.Flat}"/>
                                                <ComboBoxItem Content="%" Tag="{x:Static models:MemoryBonusType.ParaBonus}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- プリセット管理 -->
                        <Border BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="プリセット" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#666" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MemoryPresetCountText}" FontSize="11"
                                               Foreground="#999" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding MemoryPresets}"
                                              SelectedItem="{Binding SelectedMemoryPreset}"
                                              DisplayMemberPath="Name"
                                              DropDownClosed="OnMemoryPresetDropDownClosed"
                                              FontSize="12" Padding="6,4"/>
                                    <Button Grid.Column="1" Content="削除"
                                            Command="{Binding DeleteMemoryPresetCommand}"
                                            Style="{StaticResource DangerButton}"
                                            FontSize="11" Padding="10,4" Margin="6,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="6,4"
                                             ToolTip="保存するプリセット名を入力（同名があれば上書き）"/>
                                    <Button Grid.Column="1" Content="現在の設定を保存"
                                            Command="{Binding SaveMemoryPresetCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            FontSize="11" Padding="10,4" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" Content="すべてクリア"
                                            Command="{Binding ClearMemoryBonusesCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            FontSize="11" Padding="10,4" Margin="6,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- レッスン内イベント回数 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="レッスン内イベント回数" Style="{StaticResource SectionHeader}" Margin="0"/>
                        <ComboBox ItemsSource="{Binding EventCountTemplates}"
                                  SelectedItem="{Binding SelectedEventTemplate}"
                                  FontSize="12" Padding="6,4" Width="180" Margin="16,0,0,0"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Expander Header="詳細を編集" IsExpanded="False" FontSize="12" Foreground="#666">
                    <StackPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <!-- 列1: アイテム系 -->
                        <StackPanel Margin="0,0,24,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pドリンク獲得" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding PDrinkAcquire, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         Style="{StaticResource NumericTextBox}"
                                         FontSize="12" Padding="4,3" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pアイテム獲得" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding PItemAcquire, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         Style="{StaticResource NumericTextBox}"
                                         FontSize="12" Padding="4,3" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="スキル(SSR)獲得" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SkillSsrAcquire, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         Style="{StaticResource NumericTextBox}"
                                         FontSize="12" Padding="4,3" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="スキルカード獲得" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SkillAcquire, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         Style="{StaticResource NumericTextBox}"
                                         FontSize="12" Padding="4,3" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="相談ドリンク交換" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding ConsultationDrink, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         Style="{StaticResource NumericTextBox}"
                                         FontSize="12" Padding="4,3" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- 列2: スキル操作系 -->
                        <StackPanel Margin="0,0,24,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="55"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="スキル強化" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding SkillEnhance, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         Style="{StaticResource NumericTextBox}"
                                         FontSize="12" Padding="4,3" HorizontalContentAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
