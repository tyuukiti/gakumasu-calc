                <Button Content="リセット" Command="{Binding ResetCommand}"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>

            <!-- ===== 計算結果 (Web版と同じく最上部に配置) ===== -->
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="計算結果" Style="{StaticResource SectionHeader}"/>

                    <!-- Vo -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Vocal" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource VoBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Height="24" CornerRadius="12"
                                Background="#F0F0F0" ClipToBounds="True">
                            <Grid>
                                <!-- 合計バー(暗色)：差分が右端に暗く見える -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding VoBarColumn}"/>
                                        <ColumnDefinition Width="{Binding VoBarColumnRemain}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource VoBrushDark}"
                                            CornerRadius="12"/>
                                </Grid>
                                <!-- 補正なしバー(通常色)を上に重ねる -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding VoBarColumnBase}"/>
                                        <ColumnDefinition Width="{Binding VoBarColumnBaseRemain}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource VoBrush}"
                                            CornerRadius="12"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ResultVo, StringFormat={}{0:#,0}}"
                                       FontSize="14" FontWeight="Bold" FontFamily="Consolas"
                                       HorizontalAlignment="Right"
                                       ToolTip="実ゲーム表示値 (cap 適用後)">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVoAtCap}" Value="True">
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ResultVoDeltaText}" FontSize="10" FontFamily="Consolas"
                                       Foreground="#888" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding ResultVoOverflowText}" FontSize="10" FontFamily="Consolas"
                                       Foreground="#999" HorizontalAlignment="Right"
                                       ToolTip="cap 前の生数値 (差分は実ゲームで打ち止め)"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="MAX" FontSize="10" FontWeight="Bold"
                                   Foreground="#EF4444" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Visibility="{Binding IsVoAtCap, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

