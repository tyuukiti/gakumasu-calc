            <!-- ===== 編成パターン (Web版と同じボタン切替式) ===== -->
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="編成パターン" Style="{StaticResource SectionHeader}"/>

                    <!-- パターン切替ボタン -->
                    <ItemsControl ItemsSource="{Binding PatternResults}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,6" Padding="10,6" Cursor="Hand"
                                        Command="{Binding DataContext.SelectPatternCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="#555"/>
                                            <Setter Property="BorderBrush" Value="#CCC"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <TextBlock FontSize="10"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   Opacity="0.7">
                                            <Run Text="合計: "/><Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:#,0}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 選択中デッキのカード一覧 -->
                    <ItemsControl ItemsSource="{Binding DeckCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- ヘッダ行 (クリックで IsExpanded トグル) -->
                                    <Border Padding="4,5" BorderBrush="#F0F0F0" BorderThickness="0,1,0,0"
                                            Cursor="Hand" Background="Transparent">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding ToggleExpandCommand}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 属性バッジ (色付き) -->
                                            <Border Grid.Column="0" Background="{Binding TypeBadgeBackground}" CornerRadius="3"
                                                    Padding="4,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding CardTypeDisplay}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding TypeBadgeForeground}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding CardPlanDisplay}"
                                                       FontSize="10" Foreground="#999"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CardRarity}"
                                                       FontSize="10" Foreground="#888"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"/>
                                            <!-- SP率バッジ -->
                                            <Border Grid.Column="3" Background="#E8F5E9" CornerRadius="2"
                                                    Padding="3,1" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Margin="2,0"
                                                    Visibility="{Binding SpRateVisibility}">
                                                <TextBlock Text="SP" FontSize="9" FontWeight="Bold"
                                                           Foreground="#2E7D32"/>
                                            </Border>
                                            <!-- 凸数バッジ + カード名 (レンタル=オレンジ, 必須=紫) -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="4,0,0,0">
                                                <Border Background="#EEF2FF" CornerRadius="2" Padding="3,1"
                                                        Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UncapDisplay}" FontSize="9"
                                                               FontWeight="Bold" Foreground="#4F46E5"/>
                                                </Border>
                                                <TextBlock Text="{Binding CardName}" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding CardNameForeground}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="5" Text="{Binding StatValueDisplay}"
                                                       FontSize="13" FontWeight="SemiBold" FontFamily="Consolas"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <!-- 除外ボタン (必須カード以外で表示) -->
                                            <Button Grid.Column="6" Content="除外" FontSize="10"
                                                    Padding="6,1" Margin="2,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding ExcludeButtonVisibility}"
                                                    Command="{Binding DataContext.ExcludeCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding CardId}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="#C0392B" MinWidth="0" MinHeight="0"
                                                    ToolTip="このカードを除外して再計算"/>
                                            <!-- 展開矢印 (▶ / ▼) -->
                                            <TextBlock Grid.Column="7" FontSize="10" Foreground="#AAA"
                                                       VerticalAlignment="Center" Margin="2,0,2,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▶"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Text" Value="▼"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <!-- 展開時の内訳パネル -->
                                    <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                            Background="#FAFAFA" Padding="14,4,8,8">
                                        <StackPanel>
                                            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#666">
                                                <Run Text="Vo:"/><Run Text="{Binding RawVo, Mode=OneWay}"/>
                                                <Run Text="  Da:"/><Run Text="{Binding RawDa, Mode=OneWay}"/>
                                                <Run Text="  Vi:"/><Run Text="{Binding RawVi, Mode=OneWay}"/>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Breakdowns}" Margin="0,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Reason}"
                                                                       FontFamily="Consolas" FontSize="11"
                                                                       Foreground="#888"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding ValueDisplay}"
                                                                       FontFamily="Consolas" FontSize="11"
                                                                       Foreground="{Binding StatColor}"
                                                                       Margin="8,0,0,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== ターン選択 (折りたたみ式) ===== -->
            <Border Style="{StaticResource SectionCard}"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <Expander IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="週別内訳・ターン選択" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#333" VerticalAlignment="Center"/>
                            <Button Content="レッスン再計算" Command="{Binding RecalcLessonCommand}"
                                    Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,3"
                                    Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TurnChoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding WeekLabel}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Foreground="#555"/>

                                                <!-- 固定イベント -->
                                                <TextBlock Grid.Column="1" Text="{Binding EventName}"
                                                           FontSize="12" Foreground="#999" FontStyle="Italic"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsFixedEvent, Converter={StaticResource BoolToVis}}"/>

                                                <!-- アクション選択 (ドロップダウン) -->
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableActions}"
                                                          SelectedItem="{Binding SelectedAction}"
                                                          FontSize="11" Padding="6,3" MinWidth="120"
                                                          Visibility="{Binding IsFixedEvent, Converter={StaticResource InverseBoolToVis}}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource ActionToStr}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Expander>
            </Border>

            <!-- バージョン情報 + 手動アップデート確認 -->
            <Border Margin="0,4,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentVersion, StringFormat='ver {0}'}"
                               FontSize="11" Foreground="#999" VerticalAlignment="Center"/>
                    <Button Content="更新を確認" Command="{Binding CheckUpdateCommand}"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="11" Padding="10,4" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding VersionCheckStatus}"
                               FontSize="11" Foreground="#666" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="HIFモード">
            <views:HifTabContent/>
        </TabItem>
    </TabControl>
</Window>
